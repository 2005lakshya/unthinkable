NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role for admin tasks (if needed in backend scripts)
SUPABASE_URL=https://your-supabase-project-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_PUBLISHABLE_KEYS=your-publishable-key
SUPABASE_SECRET_KEYS=your-secret-key

# Direct connection to the Postgres database
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWKS=your-jwks-id

# Email provider (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="BookSeat <tickets@yourdomain.com>"
